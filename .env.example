# Backend Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
COOKIE_SECURE=false

# SQLite Database Path (optional override, defaults to backend/data/app.db)
DATABASE_PATH=data/app.db

# Frontend Production Configuration (optional override for deployed static hosts)
# VITE_API_BASE_URL=https://sms-spam-detector-backend.onrender.com

